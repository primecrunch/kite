 KITE_NORM(bo)
 KITE_NORM(boe)
 KITE_NORM(co)
+// compressed weights in the table's scaled form, 1 or 2 row pairs per iteration (gen_norm_cmp)
+KITE_NORM(ax)
+KITE_NORM(axe)
+KITE_NORM(bx)
+KITE_NORM(bxe)
+KITE_NORM(cx)
+KITE_NORM(ay)
+KITE_NORM(aye)
+KITE_NORM(by)
+KITE_NORM(bye)
+KITE_NORM(cy)
 #undef KITE_NORM
 
 void kite_rows_in(const double *rp, const double *rpp, double *scr, size_t C);

# src/neon.c norm_rows, compressed branch:
        // two row pairs (two carry chains) per call, one for an odd pair left over
        static const norm_fn yfns[3][2] = {
            {kite_norm_ay, kite_norm_aye}, {kite_norm_by, kite_norm_bye}, {kite_norm_cy, kite_norm_cy}};
        static const norm_fn xfns[3][2] = {
            {kite_norm_ax, kite_norm_axe}, {kite_norm_bx, kite_norm_bxe}, {kite_norm_cx, kite_norm_cx}};
        size_t np = (r1 - r0) / 2, ny = np & ~(size_t)1;
        e = 0;
        if (ny) e = yfns[mode][err](gb, st->rowstride, ny, carr + r0, st->A + idx, st->IA + idx,
                                    st->mask + idx, st->nconsts);
        if (np - ny) {
            size_t o = 2 * ny;
            double e2 = xfns[mode][err]((double *)((char *)gb + o * st->rowstride), st->rowstride,
                                        1, carr + r0 + o, st->A + idx + o, st->IA + idx + o,
                                        st->mask + idx + o, st->nconsts);
            if (e2 > e) e = e2;
        }
