+// KITE_T4=table|gen overrides the choice of four-step twiddles (for measurement).
+static int t4_policy(const kite_ctx *ctx, uint32_t H) {
+    const char *e = getenv("KITE_T4");
+    (void)ctx;
+    (void)H;
+    if (e && !strcmp(e, "table")) return 0;
+    if (e && !strcmp(e, "gen")) return 1;
+    return 1;
+}
+
+// Table-driven normaliser: 48 bytes per element against 3 for the compressed weights. KITE_NTAB
+// =on|off overrides (KITE_NO_NTAB=1 is the old spelling of off).
+static int ntab_policy(const kite_ctx *ctx, uint32_t H) {
+    const char *e = getenv("KITE_NTAB");
+    (void)ctx;
+    if (getenv("KITE_NO_NTAB")) return 0;
+    if (e && !strcmp(e, "on")) return 1;
+    if (e && !strcmp(e, "off")) return 0;
+    return H <= (1u << 17);
+}
